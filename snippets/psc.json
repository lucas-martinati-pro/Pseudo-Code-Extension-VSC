{
  "Algorithme principal": {
    "prefix": "algorithme",
    "body": [
      "Algorithme ${1:NomPrincipal}",
      "Début",
      "\t$0",
      "Fin",
      "/*",
      "Lexique :",
      "${2:variable} : ${3:type}",
      "*/"
    ],
    "description": "Crée une structure d'algorithme principal."
  },
  "Fonction complète": {
    "prefix": "fonction",
    "body": [
      "Fonction ${1:nomFonction}(${2:paramètres}) : ${3:typeRetour}",
      "Début",
      "\t$0",
      "Fin",
      "/*",
      "Lexique :",
      "${4:variable} : ${5:type}",
      "*/"
    ],
    "description": "Crée une structure de fonction complète avec lexique."
  },
  "Procédure (fonction sans retour)": {
    "prefix": "procedure",
    "body": [
      "Fonction ${1:nomProcedure}(${2:paramètres})",
      "Début",
      "\t$0",
      "Fin"
    ],
    "description": "Crée une procédure (fonction sans valeur de retour)."
  },
  "Boucle Pour": {
    "prefix": "pour",
    "body": [
      "Pour ${1:i} de ${2:début} à ${3:fin} Faire :",
      "\t$0",
      "fpour"
    ],
    "description": "Crée une boucle Pour."
  },
  "Boucle Pour décroissant": {
    "prefix": "pourdec",
    "body": [
      "Pour ${1:i} de ${2:fin} à ${3:début} décroissant Faire :",
      "\t$0",
      "fpour"
    ],
    "description": "Crée une boucle Pour décroissante."
  },
  "Boucle Tant que": {
    "prefix": "tantque",
    "body": [
      "Tant que ${1:condition} Faire :",
      "\t$0",
      "ftq"
    ],
    "description": "Crée une boucle Tant que."
  },
  "Structure Si/Alors": {
    "prefix": "si",
    "body": [
      "Si ${1:condition} Alors :",
      "\t$0",
      "fsi"
    ],
    "description": "Crée une structure conditionnelle Si/Alors."
  },
  "Structure Si/Alors/Sinon": {
    "prefix": "sisinon",
    "body": [
      "Si ${1:condition} Alors :",
      "\t${2:/* instructions si vrai */}",
      "Sinon :",
      "\t${3:/* instructions si faux */}",
      "fsi"
    ],
    "description": "Crée une structure conditionnelle Si/Alors/Sinon."
  },
  "Structure Si/Sinon si/Sinon": {
    "prefix": "sicomplet",
    "body": [
      "Si ${1:condition1} Alors :",
      "\t${2:/* instructions */}",
      "Sinon si ${3:condition2} Alors :",
      "\t${4:/* instructions */}",
      "Sinon :",
      "\t${5:/* instructions */}",
      "fsi"
    ],
    "description": "Crée une structure conditionnelle complète Si/Sinon si/Sinon."
  },
  "Écrire (affichage)": {
    "prefix": "ecrire",
    "body": [
      "écrire(${1:valeur})"
    ],
    "description": "Affiche une valeur dans la sortie standard."
  },
  "Lire (saisie)": {
    "prefix": "lire",
    "body": [
      "${1:variable} ← lire()"
    ],
    "description": "Lit une valeur depuis l'entrée standard."
  },
  "Déclaration de tableau": {
    "prefix": "tableau",
    "body": [
      "${1:tab} ← tableau ${2:entier}[${3:0}..${4:9}]"
    ],
    "description": "Déclare et initialise un tableau."
  },
  "Type composite (structure)": {
    "prefix": "type",
    "body": [
      "${1:NomType} = <${2:champ1} : ${3:type1}, ${4:champ2} : ${5:type2}>"
    ],
    "description": "Déclare un type composite (structure) avec des champs nommés."
  },
  "Retourner": {
    "prefix": "retourner",
    "body": [
      "retourner ${1:valeur}"
    ],
    "description": "Retourne une valeur depuis une fonction."
  }
}