{
  "comments": {
    "lineComment": "//",
    "blockComment": [ "/*", "*/" ]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] },
    { "open": "/*", "close": " */", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(?:[Dd][éeÉ]but|[Ss]i\\b.*[Aa]lors\\s*:?|[Pp]our\\b.*[Ff]aire\\s*:?|[Tt]ant\\s+[Qq]ue\\b.*[Ff]aire\\s*:?|[Ss]inon\\s*:?)\\s*(?://.*)?$",
      "end": "^\\s*(?:[Ff]in|[Ff]si|[Ff]pour|[Ff]tq|[Ff]tant)\\b"
    }
  },
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)",
  "indentationRules": {
    "increaseIndentPattern": {
      "pattern": "^\\s*(d[ée]but|.*\\b(alors|faire)\\s*:?|sinon(\\s+si\\b.*\\balors)?\\s*:?|lexique\\s*:?)\\s*(//.*)?$",
      "flags": "i"
    },
    "decreaseIndentPattern": {
      "pattern": "^\\s*(fin\\b|fsi\\b|fpour\\b|ftq\\b|ftant\\b|sinon\\b)",
      "flags": "i"
    }
  },
  "onEnterRules": [
    {
      "beforeText": {
        "pattern": "^\\s*(d[ée]but|.*\\b(alors|faire)\\s*:?|sinon(\\s+si\\b.*\\balors)?\\s*:?)\\s*(//.*)?$",
        "flags": "i"
      },
      "afterText": {
        "pattern": "^\\s*(fin|fsi|fpour|ftq|ftant|sinon)\\b",
        "flags": "i"
      },
      "action": {
        "indent": "indentOutdent"
      }
    },
    {
      "beforeText": {
        "pattern": "^\\s*(d[ée]but|.*\\b(alors|faire)\\s*:?|sinon(\\s+si\\b.*\\balors)?\\s*:?|lexique\\s*:?)\\s*(//.*)?$",
        "flags": "i"
      },
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": {
        "pattern": "^\\s*(fin|fsi|fpour|ftq|ftant)\\b.*$",
        "flags": "i"
      },
      "action": {
        "indent": "none"
      }
    },
    {
      "beforeText": "^\\s*$",
      "previousLineText": {
        "pattern": "^\\s*(fin|fsi|fpour|ftq|ftant)\\b.*$",
        "flags": "i"
      },
      "action": {
        "indent": "none"
      }
    }
  ]
}