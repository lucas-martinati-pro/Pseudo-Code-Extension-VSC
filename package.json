{
  "name": "pseudocode-interpreter",
  "displayName": "PseudoCode Language Interpreter",
  "description": "Advanced syntax highlighting, intelligent snippets and symbol navigation for the PSC language.",
  "version": "0.4.0",
  "publisher": "LucasM54",
  "author": {
    "name": "Lucas Martinati"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LucasM548/Pseudo-Code-Extension-VSC"
  },
  "icon": "icons/extension-logo.png",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Programming Languages",
    "Education",
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "pseudo-code",
    "pseudocode",
    "algorithme",
    "french",
    "français",
    "education",
    "psc",
    "transpiler",
    "lua"
  ],
  "license": "MIT",
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "psc",
        "icon": {
          "light": "./icons/psc-icon-white.png",
          "dark": "./icons/psc-icon.png"
        },
        "aliases": [
          "PseudoCode",
          "psc"
        ],
        "extensions": [
          ".psc"
        ],
        "configuration": "./language-configuration.json",
        "symbols": {
          "comments": {
            "lineComment": "//"
          },
          "brackets": [
            [
              "Début",
              "Fin"
            ]
          ]
        }
      }
    ],
    "grammars": [
      {
        "language": "psc",
        "scopeName": "source.psc",
        "path": "./syntaxes/psc.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "psc",
        "path": "./snippets/psc.json"
      }
    ],
    "formatters": [
      {
        "language": "psc",
        "displayName": "PSC Formatter",
        "id": "psc-formatter"
      }
    ],
    "commands": [
      {
        "command": "psc.execute",
        "title": "Exécuter le fichier Pseudo-Code",
        "category": "PSC",
        "icon": "$(play)"
      }
    ],
    "keybindings": [
      {
        "command": "psc.execute",
        "key": "ctrl+f5",
        "when": "resourceLangId == psc && config.psc.execution.enabled"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "psc.execute",
          "when": "resourceLangId == psc && config.psc.execution.enabled",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Pseudo-Code (PSC)",
      "properties": {
        "psc.execution.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Activer/désactiver la transpilation et l'exécution du pseudo-code (bouton ▶️ et Ctrl+F5). La coloration syntaxique reste active.",
          "order": 1
        },
        "psc.linter.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Activer/désactiver l'analyse diagnostique en temps réel (vérification des blocs, variables non déclarées, arité des fonctions).",
          "order": 2
        },
        "psc.intellisense.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Activer/désactiver l'autocomplétion, l'aide à la signature, le survol informatif et la navigation vers les définitions.",
          "order": 3
        }
      }
    },
    "configurationDefaults": {
      "[psc]": {
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "off"
        },
        "editor.suggest.showSnippets": true,
        "editor.snippetSuggestions": "top",
        "editor.suggest.insertMode": "replace",
        "editor.wordBasedSuggestions": "off",
        "editor.suggest.localityBonus": true,
        "editor.acceptSuggestionOnCommitCharacter": true
      }
    }
  },
  "scripts": {
    "generate-grammar": "tsc -p tsconfig.scripts.json && node out/scripts/generate-grammar.js",
    "precompile": "npm run generate-grammar",
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.6.0",
    "@types/vscode": "^1.104.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.9.3"
  }
}
